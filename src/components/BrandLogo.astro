---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;

const sizeClasses = {
  sm: 'h-7 w-7',
  md: 'h-10 w-10 sm:h-12 sm:w-12',
  lg: 'h-12 w-12 sm:h-14 sm:w-14',
}[size];
---

<img
  src="/logo.svg"
  alt="たびろーむ ロゴ"
  width="56"
  height="56"
  class={`inline-block shrink-0 select-none ${sizeClasses} ${className}`}
/>

