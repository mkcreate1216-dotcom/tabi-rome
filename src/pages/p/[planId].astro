---
import PlannerLayout from '../../layouts/PlannerLayout.astro';
import { cleanupExpiredPlans, isPlanExpired } from '../../utils/planCleanup';

export const prerender = false;

const { planId } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;

let initialPlanData: any = null;

if (planId && db) {
  try {
    await cleanupExpiredPlans(db);

    const plan = await db
      .prepare(`SELECT id, title, data, version, updated_at FROM plans WHERE id = ?`)
      .bind(planId)
      .first<{ id: string; title: string; data: string; version: number; updated_at: string }>();

    if (plan) {
      if (isPlanExpired(plan.updated_at)) {
        await db.prepare(`DELETE FROM plans WHERE id = ?`).bind(planId).run();
      } else {
        initialPlanData = {
          id: plan.id,
          title: plan.title,
          data: JSON.parse(plan.data),
          version: plan.version,
          updatedAt: plan.updated_at,
        };
      }
    }
  } catch (err) {
    console.error('Error fetching plan in SSR:', err);
  }
}

if (!initialPlanData) {
  return Astro.redirect('/?notfound=1');
}

const pageTitle = `${initialPlanData.title} - たびろーむ`;
const dayCount = Array.isArray(initialPlanData.data?.days) ? initialPlanData.data.days.length : 1;
const spotPreviewList: string[] = [];
if (Array.isArray(initialPlanData.data?.days)) {
  for (const day of initialPlanData.data.days) {
    if (Array.isArray(day?.spots)) {
      for (const spot of day.spots) {
        const name = typeof spot === 'string' ? spot.trim() : spot?.name?.trim();
        if (name && !spotPreviewList.includes(name) && spotPreviewList.length < 4) {
          spotPreviewList.push(name);
        }
      }
    }
  }
}
const spotsSummary = spotPreviewList.length > 0 ? `（${spotPreviewList.join('・')} ほか）` : '';
const pageDescription = `「${initialPlanData.title}」の旅程（全${dayCount}日）${spotsSummary}。たびろーむでスポットや移動ルートを確認・共有できます。`;
---

<PlannerLayout
  title={pageTitle}
  description={pageDescription}
  ogType="article"
  initialPlanData={initialPlanData}
/>
